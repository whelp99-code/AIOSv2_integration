// --- M2: portal automation/kernel (additive, Automation* on BLRO conflicts) ---

model AutomationProject {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  slug           String   @unique
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization?            @relation(fields: [organizationId], references: [id])
  members            AutomationProjectMember[]
  commandRuns        CommandRun[]
  mailInsightThreads MailInsightThread[]
  policyMemories     PolicyMemory[]
  policyDecisionLogs PolicyDecisionLog[]
  workspaces         AutomationWorkspace[]
  automationPortalTasks AutomationPortalTask[]
  automationKnowledgeDocuments AutomationKnowledgeDocument[]
  automationMailAccounts AutomationMailAccount[]

  @@index([organizationId])
  @@map("automation_projects")
}

model AutomationProjectMember {
  id                  String   @id @default(cuid())
  automationProjectId String   @map("automation_project_id")
  userId              String   @map("user_id")
  role                String   @default("member")
  createdAt           DateTime @default(now()) @map("created_at")

  automationProject AutomationProject @relation(fields: [automationProjectId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([automationProjectId, userId])
  @@map("automation_project_members")
}

model AutomationWorkspace {
  id                  String   @id @default(cuid())
  automationProjectId String   @map("automation_project_id")
  name                String
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  automationProject AutomationProject @relation(fields: [automationProjectId], references: [id], onDelete: Cascade)

  @@index([automationProjectId])
  @@map("automation_workspaces")
}

model ConfigProfile {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  values ConfigValue[]

  @@map("config_profiles")
}

model ConfigValue {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  key       String
  valueJson Json     @map("value_json")
  createdAt DateTime @default(now()) @map("created_at")

  profile ConfigProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, key])
  @@map("config_values")
}

model Command {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  runs CommandRun[]

  @@map("commands")
}

model CommandRun {
  id                   String   @id @default(cuid())
  commandId            String   @map("command_id")
  automationProjectId  String   @map("automation_project_id")
  requestedById        String?  @map("requested_by_id")
  status               String   @default("pending")
  inputSummary         String?  @map("input_summary")
  sourceEntityType     String?  @map("source_entity_type")
  sourceEntityId       String?  @map("source_entity_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  command              Command              @relation(fields: [commandId], references: [id])
  automationProject    AutomationProject    @relation(fields: [automationProjectId], references: [id])
  requestedBy          User?                @relation("CommandRunRequestedBy", fields: [requestedById], references: [id])
  automationWorkflows  AutomationWorkflow[]
  intent               IntentAnalysis?
  risk                 RiskAnalysis?
  codeChanges          CodeChange[]         @relation("CommandRunCodeChanges")
  skillRuns            SkillRun[]
  workBreakdownItems   WorkBreakdownItem[]
  improvementCandidates ImprovementCandidate[]

  @@index([automationProjectId, status])
  @@index([commandId])
  @@index([sourceEntityType, sourceEntityId])
  @@map("command_runs")
}

model ImprovementCandidate {
  id              String   @id @default(cuid())
  sourceType      String   @map("source_type")
  sourceId        String?  @map("source_id")
  title           String
  summary         String
  severity        String   @default("medium")
  suggestedModule String?  @map("suggested_module")
  suggestedAction String?  @map("suggested_action")
  status          String   @default("proposed")
  commandRunId    String?  @map("command_run_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  commandRun CommandRun? @relation(fields: [commandRunId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("improvement_candidates")
}

model AutomationWorkflow {
  id           String   @id @default(cuid())
  commandRunId String   @map("command_run_id")
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  commandRun CommandRun               @relation(fields: [commandRunId], references: [id], onDelete: Cascade)
  steps      AutomationWorkflowStep[]

  @@index([commandRunId])
  @@map("automation_workflows")
}

model AutomationWorkflowStep {
  id                   String   @id @default(cuid())
  automationWorkflowId String   @map("automation_workflow_id")
  stepKey              String   @map("step_key")
  status               String   @default("pending")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  automationWorkflow AutomationWorkflow @relation(fields: [automationWorkflowId], references: [id], onDelete: Cascade)
  agentAssignments   AgentAssignment[]
  validationResults  ValidationResult[]

  @@index([automationWorkflowId, sortOrder])
  @@map("automation_workflow_steps")
}

model AgentAssignment {
  id                       String   @id @default(cuid())
  automationWorkflowStepId String   @map("automation_workflow_step_id")
  agentKey                 String   @map("agent_key")
  status                   String   @default("assigned")
  createdAt                DateTime @default(now()) @map("created_at")

  automationWorkflowStep AutomationWorkflowStep @relation(fields: [automationWorkflowStepId], references: [id], onDelete: Cascade)
  toolCalls              ToolCall[]
  messages               AgentMessage[]
  decisions              AgentDecisionLog[]

  @@index([automationWorkflowStepId])
  @@map("agent_assignments")
}

model ToolCall {
  id                String   @id @default(cuid())
  agentAssignmentId String   @map("agent_assignment_id")
  toolKey           String   @map("tool_key")
  status            String   @default("pending")
  errorJson         Json?    @map("error_json")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  agentAssignment AgentAssignment @relation(fields: [agentAssignmentId], references: [id], onDelete: Cascade)

  @@index([agentAssignmentId])
  @@map("tool_calls")
}

model ValidationResult {
  id                       String   @id @default(cuid())
  automationWorkflowStepId String   @map("automation_workflow_step_id")
  checkKey                 String   @map("check_key")
  status                   String
  detailsJson              Json?    @map("details_json")
  createdAt                DateTime @default(now()) @map("created_at")

  automationWorkflowStep AutomationWorkflowStep @relation(fields: [automationWorkflowStepId], references: [id], onDelete: Cascade)
  reports                AutomationReport[]

  @@index([automationWorkflowStepId])
  @@map("validation_results")
}

model AutomationReport {
  id                 String   @id @default(cuid())
  validationResultId String   @map("validation_result_id")
  title              String
  bodyMarkdown       String?  @map("body_markdown")
  createdAt          DateTime @default(now()) @map("created_at")

  validationResult ValidationResult @relation(fields: [validationResultId], references: [id], onDelete: Cascade)

  @@map("automation_reports")
}

model IntentAnalysis {
  id           String   @id @default(cuid())
  commandRunId String   @unique @map("command_run_id")
  summary      String
  intentJson   Json     @map("intent_json")
  createdAt    DateTime @default(now()) @map("created_at")

  commandRun CommandRun @relation(fields: [commandRunId], references: [id], onDelete: Cascade)

  @@map("intent_analyses")
}

model RiskAnalysis {
  id           String   @id @default(cuid())
  commandRunId String   @unique @map("command_run_id")
  riskLevel    String   @map("risk_level")
  riskJson     Json     @map("risk_json")
  createdAt    DateTime @default(now()) @map("created_at")

  commandRun CommandRun @relation(fields: [commandRunId], references: [id], onDelete: Cascade)

  @@map("risk_analyses")
}

model AgentMessage {
  id                String   @id @default(cuid())
  agentAssignmentId String   @map("agent_assignment_id")
  role              String
  content           String
  createdAt         DateTime @default(now()) @map("created_at")

  agentAssignment AgentAssignment @relation(fields: [agentAssignmentId], references: [id], onDelete: Cascade)

  @@index([agentAssignmentId])
  @@map("agent_messages")
}

model AgentDecisionLog {
  id                String   @id @default(cuid())
  agentAssignmentId String   @map("agent_assignment_id")
  decision          String
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  agentAssignment AgentAssignment @relation(fields: [agentAssignmentId], references: [id], onDelete: Cascade)

  @@index([agentAssignmentId])
  @@map("agent_decision_logs")
}

model AutomationApprovalRequest {
  id            String   @id @default(cuid())
  commandRunId  String?  @map("command_run_id")
  pullRequestId String?  @map("pull_request_id")
  status        String   @default("pending")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("automation_approval_requests")
}

model Repository {
  id        String   @id @default(cuid())
  slug      String   @unique
  remoteUrl String?  @map("remote_url")
  createdAt DateTime @default(now()) @map("created_at")

  pullRequests PullRequest[]
  branches     Branch[]

  @@map("repositories")
}

model Branch {
  id           String   @id @default(cuid())
  repositoryId String   @map("repository_id")
  name         String
  headSha      String?  @map("head_sha")
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@map("branches")
}

model PullRequest {
  id           String   @id @default(cuid())
  repositoryId String   @map("repository_id")
  number       Int
  title        String
  status       String   @default("open")
  url          String?
  ciStatus     String?  @map("ci_status")
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  codeChanges CodeChange[]

  @@unique([repositoryId, number])
  @@map("pull_requests")
}

model CodeChange {
  id            String   @id @default(cuid())
  pullRequestId String?  @map("pull_request_id")
  commandRunId  String?  @map("command_run_id")
  summary       String
  createdAt     DateTime @default(now()) @map("created_at")

  pullRequest PullRequest? @relation(fields: [pullRequestId], references: [id])
  commandRun  CommandRun?  @relation("CommandRunCodeChanges", fields: [commandRunId], references: [id])
  changedFiles ChangedFile[]
  buildRuns   BuildRun[]

  @@index([commandRunId])
  @@map("code_changes")
}

model BuildRun {
  id           String   @id @default(cuid())
  codeChangeId String?  @map("code_change_id")
  commandRunId String?  @map("command_run_id")
  status       String   @default("pending")
  logSummary   String?  @map("log_summary")
  createdAt    DateTime @default(now()) @map("created_at")

  codeChange CodeChange? @relation(fields: [codeChangeId], references: [id])
  testRuns   TestRun[]

  @@index([commandRunId])
  @@map("build_runs")
}

model TestRun {
  id           String   @id @default(cuid())
  buildRunId   String?  @map("build_run_id")
  commandRunId String?  @map("command_run_id")
  status       String   @default("pending")
  passed       Int      @default(0)
  failed       Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  buildRun BuildRun? @relation(fields: [buildRunId], references: [id])

  @@index([commandRunId])
  @@map("test_runs")
}

model ChangedFile {
  id           String @id @default(cuid())
  codeChangeId String @map("code_change_id")
  path         String
  changeType   String @map("change_type")

  codeChange CodeChange @relation(fields: [codeChangeId], references: [id], onDelete: Cascade)

  @@index([codeChangeId])
  @@map("changed_files")
}

model ModuleRegistry {
  id             String   @id @default(cuid())
  moduleKey      String   @unique @map("module_key")
  displayName    String   @map("display_name")
  version        String   @default("0.1.0")
  dependencyJson Json?    @map("dependency_json")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  blocks BlockRegistry[]
  nodes  NodeRegistry[]

  @@map("module_registry")
}

model BlockRegistry {
  id          String   @id @default(cuid())
  blockKey    String   @unique @map("block_key")
  moduleKey   String   @map("module_key")
  displayName String   @map("display_name")
  configJson  Json?    @map("config_json")
  createdAt   DateTime @default(now()) @map("created_at")

  module      ModuleRegistry @relation(fields: [moduleKey], references: [moduleKey])
  layoutSlots LayoutSlot[]

  @@index([moduleKey])
  @@map("block_registry")
}

model LayoutSlot {
  id              String  @id @default(cuid())
  pageKey         String  @map("page_key")
  slotKey         String  @map("slot_key")
  sortOrder       Int     @default(0) @map("sort_order")
  blockRegistryId String? @map("block_registry_id")

  block BlockRegistry? @relation(fields: [blockRegistryId], references: [id])

  @@unique([pageKey, slotKey])
  @@index([pageKey, sortOrder])
  @@map("layout_slots")
}

model NodeRegistry {
  id         String   @id @default(cuid())
  nodeKey    String   @unique @map("node_key")
  moduleKey  String   @map("module_key")
  nodeType   String   @map("node_type")
  configJson Json?    @map("config_json")
  createdAt  DateTime @default(now()) @map("created_at")

  module ModuleRegistry @relation(fields: [moduleKey], references: [moduleKey])

  @@index([moduleKey])
  @@map("node_registry")
}

model QueryRegistry {
  id         String   @id @default(cuid())
  queryKey   String   @unique @map("query_key")
  sourceType String   @map("source_type")
  configJson Json     @map("config_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("query_registry")
}

model StateTransitionLog {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorType  String?  @map("actor_type")
  actorId    String?  @map("actor_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("state_transition_logs")
}

model OutboxEvent {
  id            String    @id @default(cuid())
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  status        String    @default("pending")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?  @map("actor_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model ErrorEvent {
  id        String   @id @default(cuid())
  source    String
  message   String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("error_events")
}

model ValidationPlan {
  id           String   @id @default(cuid())
  commandRunId String?  @map("command_run_id")
  name         String
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")

  checks ValidationCheck[]

  @@map("validation_plans")
}

model ValidationCheck {
  id       String @id @default(cuid())
  planId   String @map("plan_id")
  checkKey String @map("check_key")
  status   String @default("pending")

  plan ValidationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("validation_checks")
}

model QualityGate {
  id             String   @id @default(cuid())
  gateKey        String   @unique @map("gate_key")
  requiredChecks Json     @map("required_checks")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("quality_gates")
}

model CostEvent {
  id           String   @id @default(cuid())
  commandRunId String?  @map("command_run_id")
  source       String
  amountUsd    Float    @map("amount_usd")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([commandRunId])
  @@map("cost_events")
}

model AutomationMailAccount {
  id                  String   @id @default(cuid())
  automationProjectId String   @map("automation_project_id")
  provider            String   @default("outlook")
  email               String
  status              String   @default("mock")
  createdAt           DateTime @default(now()) @map("created_at")

  automationProject AutomationProject @relation(fields: [automationProjectId], references: [id], onDelete: Cascade)
  messages          AutomationMailMessage[]

  @@map("automation_mail_accounts")
}

model AutomationMailMessage {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  subject   String
  fromEmail String   @map("from_email")
  bodyPreview String? @map("body_preview")
  groupKey  String?  @map("group_key")
  createdAt DateTime @default(now()) @map("created_at")

  account AutomationMailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("automation_mail_messages")
}

model AutomationPortalTask {
  id                  String   @id @default(cuid())
  automationProjectId String   @map("automation_project_id")
  title               String
  status              String   @default("open")
  source              String   @default("portal")
  createdAt           DateTime @default(now()) @map("created_at")

  automationProject AutomationProject @relation(fields: [automationProjectId], references: [id], onDelete: Cascade)

  @@index([automationProjectId, status])
  @@map("automation_portal_tasks")
}

model AutomationKnowledgeDocument {
  id                  String   @id @default(cuid())
  automationProjectId String   @map("automation_project_id")
  title               String
  body                String
  tags                String[] @default([])
  source              String   @default("manual")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  automationProject AutomationProject @relation(fields: [automationProjectId], references: [id], onDelete: Cascade)
  chunks            KnowledgeChunk[]
  mailInsightThreads MailInsightThread[]

  @@index([automationProjectId])
  @@map("automation_knowledge_documents")
}

model MailDerivedCandidate {
  id                          String    @id @default(cuid())
  automationKnowledgeDocumentId String? @map("automation_knowledge_document_id")
  candidateType               String    @map("candidate_type")
  title                       String
  summary                     String
  sourceTitle                 String?   @map("source_title")
  sourceSender                String?   @map("source_sender")
  sourceReceivedAt            DateTime? @map("source_received_at")
  confidence                  Int       @default(60)
  status                      String    @default("proposed")
  createdEntityType           String?   @map("created_entity_type")
  createdEntityId             String?   @map("created_entity_id")
  metadata                    Json?
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  mailInsightThreadId         String?   @map("mail_insight_thread_id")
  mailInsightThread           MailInsightThread? @relation(fields: [mailInsightThreadId], references: [id], onDelete: SetNull)

  @@unique([automationKnowledgeDocumentId, candidateType])
  @@unique([mailInsightThreadId, candidateType])
  @@index([status, candidateType, createdAt])
  @@index([automationKnowledgeDocumentId])
  @@index([mailInsightThreadId])
  @@map("mail_derived_candidates")
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  document AutomationKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("knowledge_chunks")
}

model RuntimePolicy {
  id         String   @id @default(cuid())
  policyKey  String   @unique @map("policy_key")
  configJson Json     @map("config_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("runtime_policies")
}

model ConnectorRegistry {
  id            String   @id @default(cuid())
  connectorKey  String   @unique @map("connector_key")
  displayName   String   @map("display_name")
  connectorType String   @map("connector_type")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("connector_registry")
}

model CodexTask {
  id            String   @id @default(cuid())
  commandRunId  String?  @map("command_run_id")
  title         String
  status        String   @default("pending")
  githubIssueId String?  @map("github_issue_id")
  pullRequestId String?  @map("pull_request_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  logs CodexTaskLog[]

  @@index([commandRunId])
  @@index([status])
  @@map("codex_tasks")
}

model CodexTaskLog {
  id          String   @id @default(cuid())
  codexTaskId String   @map("codex_task_id")
  status      String
  message     String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  codexTask CodexTask @relation(fields: [codexTaskId], references: [id], onDelete: Cascade)

  @@index([codexTaskId])
  @@map("codex_task_logs")
}

model CursorSession {
  id           String    @id @default(cuid())
  commandRunId String?   @map("command_run_id")
  branchName   String    @map("branch_name")
  taskSummary  String    @map("task_summary")
  status       String    @default("active")
  buildStatus  String?   @map("build_status")
  testStatus   String?   @map("test_status")
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  @@index([commandRunId])
  @@index([status])
  @@map("cursor_sessions")
}

model GitHubIssue {
  id           String   @id @default(cuid())
  commandRunId String?  @map("command_run_id")
  codexTaskId  String?  @map("codex_task_id")
  number       Int
  title        String
  url          String?
  status       String   @default("open")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([commandRunId])
  @@index([codexTaskId])
  @@map("github_issues")
}

model RunTimelineItem {
  id           String   @id @default(cuid())
  commandRunId String   @map("command_run_id")
  label        String
  status       String
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([commandRunId, sortOrder])
  @@map("run_timeline_items")
}

model NotificationEvent {
  id           String   @id @default(cuid())
  commandRunId String?  @map("command_run_id")
  eventType    String   @map("event_type")
  message      String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([commandRunId])
  @@map("notification_events")
}

model ExecutionPolicy {
  id        String   @id @default(cuid())
  policyKey String   @unique @map("policy_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("execution_policies")
}

model MemoryItem {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("memory_items")
}

model ReviewThread {
  id        String   @id @default(cuid())
  subject   String
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("review_threads")
}

model WorkflowTemplate {
  id          String   @id @default(cuid())
  templateKey String   @unique @map("template_key")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("workflow_templates")
}

model LlmCall {
  id           String   @id @default(cuid())
  commandRunId String?  @map("command_run_id")
  model        String
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  latencyMs    Int?     @map("latency_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([commandRunId])
  @@map("llm_calls")
}

model Canvas {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("canvases")
}

model SkillCatalogItem {
  id             String   @id @default(cuid())
  skillKey       String   @unique @map("skill_key")
  source         String
  plugin         String?
  phasesJson     Json     @map("phases_json")
  status         String   @default("enabled")
  usage          String?
  agentUsageJson Json     @map("agent_usage_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("skill_catalog_items")
}

model SkillRun {
  id                   String   @id @default(cuid())
  commandRunId         String?  @map("command_run_id")
  skillKey             String   @map("skill_key")
  status               String   @default("completed")
  executionMode        String   @map("execution_mode")
  sortOrder            Int      @default(0) @map("sort_order")
  rawOutputJson        Json?    @map("raw_output_json")
  normalizedOutputJson Json?    @map("normalized_output_json")
  normalizeError       String?  @map("normalize_error")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  commandRun         CommandRun?          @relation(fields: [commandRunId], references: [id], onDelete: Cascade)
  workBreakdownItems WorkBreakdownItem[]

  @@index([commandRunId, sortOrder])
  @@map("skill_runs")
}

model WorkBreakdownItem {
  id                 String   @id @default(cuid())
  commandRunId       String?  @map("command_run_id")
  skillRunId         String?  @map("skill_run_id")
  title              String
  description        String?
  targetArea         String   @map("target_area")
  agentType          String   @map("agent_type")
  riskLevel          String   @default("low") @map("risk_level")
  estimatedHours     Float    @default(2) @map("estimated_hours")
  acceptanceCriteria Json?    @map("acceptance_criteria")
  testCriteria       Json?    @map("test_criteria")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")

  commandRun CommandRun? @relation(fields: [commandRunId], references: [id], onDelete: Cascade)
  skillRun   SkillRun?   @relation(fields: [skillRunId], references: [id], onDelete: SetNull)

  @@index([commandRunId, sortOrder])
  @@map("work_breakdown_items")
}

model AgentAssignmentRule {
  id        String   @id @default(cuid())
  ruleKey   String   @unique @map("rule_key")
  pattern   String
  agentType String   @map("agent_type")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("agent_assignment_rules")
}

model MailInsightThread {
  id                            String    @id @default(cuid())
  automationProjectId           String    @map("automation_project_id")
  threadKey                     String    @map("thread_key")
  threadTitle                   String    @map("thread_title")
  sourceProvider                String    @default("mail-intelligence") @map("source_provider")
  accountId                     String?   @map("account_id")
  accountEmail                  String?   @map("account_email")
  messageCount                  Int       @default(0) @map("message_count")
  messageIds                    Json?     @map("message_ids")
  latestReceivedAt              DateTime? @map("latest_received_at")
  status                        String    @default("reference")
  effectiveStatus               String?   @map("effective_status")
  aiEnhanced                    Boolean   @default(false) @map("ai_enhanced")
  summary                       String
  nextActions                   Json?     @map("next_actions")
  evidenceItems                 Json?     @map("evidence_items")
  revenueOpsTags                String[]  @default([]) @map("revenue_ops_tags")
  participantDomains            String[]  @default([]) @map("participant_domains")
  metadata                      Json?
  automationKnowledgeDocumentId String?   @map("automation_knowledge_document_id")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  automationProject           AutomationProject            @relation(fields: [automationProjectId], references: [id], onDelete: Cascade)
  automationKnowledgeDocument AutomationKnowledgeDocument? @relation(fields: [automationKnowledgeDocumentId], references: [id], onDelete: SetNull)
  candidates                  MailDerivedCandidate[]

  @@unique([automationProjectId, threadKey])
  @@index([automationProjectId, latestReceivedAt])
  @@index([automationKnowledgeDocumentId])
  @@map("mail_insight_threads")
}

model PolicyMemory {
  id                  String   @id @default(cuid())
  automationProjectId String   @map("automation_project_id")
  memoryType          String   @map("memory_type")
  key                 String
  label               String
  valueJson           Json     @map("value_json")
  source              String   @default("seed")
  confidence          Int      @default(100)
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  automationProject AutomationProject @relation(fields: [automationProjectId], references: [id], onDelete: Cascade)

  @@unique([automationProjectId, memoryType, key])
  @@index([automationProjectId, memoryType, status])
  @@map("policy_memories")
}

model PolicyDecisionLog {
  id                  String   @id @default(cuid())
  automationProjectId String   @map("automation_project_id")
  entityType          String   @map("entity_type")
  entityId            String?  @map("entity_id")
  decisionType        String   @map("decision_type")
  inputJson           Json?    @map("input_json")
  outputJson          Json?    @map("output_json")
  policyVersion       String   @default("mail-policy-v1") @map("policy_version")
  createdAt           DateTime @default(now()) @map("created_at")

  automationProject AutomationProject @relation(fields: [automationProjectId], references: [id], onDelete: Cascade)

  @@index([automationProjectId, decisionType, createdAt])
  @@index([entityType, entityId])
  @@map("policy_decision_logs")
}
