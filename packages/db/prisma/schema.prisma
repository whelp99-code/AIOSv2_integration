// C-Stack merged schema — M1 (BLRO SSOT) + M2 (portal automation additive)
// Generated by scripts/merge-m1-m2-schema.mjs — do not edit by hand; re-run merge script

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IngestionSourceType {
  OUTLOOK_MAIL
  CALL_AUDIO
  MEETING_TRANSCRIPT
}

enum IngestionStatus {
  RECEIVED
  NORMALIZED
  EXTRACTED
  READY_FOR_REVIEW
  APPROVED
  FAILED
}

enum IngestionApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum IngestionJobStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum IngestionMailDirection {
  INBOUND
  OUTBOUND
}

enum IngestionMailCategory {
  TECH_QUESTION
  QUOTE_REQUEST
  FOLLOW_UP
  MEETING_FOLLOW_UP
  INTERNAL_NOTE
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}
enum AgentStatus {
  DRAFT
  ACTIVE
  DISABLED
}
enum CustomerStatus {
  ACTIVE
  PROSPECT
  PARTNER
  HOLD
  LOST
}
enum ProjectStatus {
  NEW_LEAD
  QUALIFICATION
  TECH_REVIEW
  PROPOSAL
  POC
  NEGOTIATION
  WON
  LOST
  HOLD
}
enum OpportunityLevel {
  LOW
  MEDIUM
  HIGH
}
enum ProductFamily {
  HCI
  HDR
  SCP
  SKE
  SASE
  NGAF
  IAG
  EPP
  NETWORK
  BACKUP
  VDI
  OTHER
}
enum MailItemType {
  CUSTOMER_REQUEST
  TECH_QUESTION
  QUOTE_REQUEST
  SCHEDULE_REQUEST
  PARTNER_REQUEST
  SUPPORT_ISSUE
  INTERNAL
  UNKNOWN
}
enum MailActionStatus {
  UNCLASSIFIED
  LINKED
  REPLY_DRAFTED
  WAITING_APPROVAL
  SENT
  NEEDS_REVIEW
}
enum ReviewStatus {
  DRAFT
  IN_REVIEW
  NEEDS_VENDOR_CHECK
  CUSTOMER_REPLY_READY
  COMPLETED
}
enum FeasibilityStatus {
  POSSIBLE
  NOT_POSSIBLE
  NEEDS_CONFIRMATION
}
enum ProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  WAITING_APPROVAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}
enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ERROR
}
enum TriggerType {
  MANUAL
  SCHEDULE
  WEBHOOK
  EMAIL
  CALENDAR
  PROJECT_STATUS_CHANGE
  SHEET_CHANGE
}
enum RunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  WAITING_APPROVAL
  CANCELED
}
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  EXPIRED
}
enum ApprovalActionType {
  SEND_EMAIL
  SEND_MESSAGE
  UPDATE
  DELETE
  PUBLISH
  MOVE
  COST_ACTION
  SEND_QUOTE
  EXTERNAL_SHARE
}
enum ConnectionProvider {
  SLACK
  NOTION
  GOOGLE_SHEETS
  GMAIL
  OUTLOOK
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
  WEBHOOK
}
enum ConnectionStatus {
  CONNECTED
  EXPIRED
  ERROR
  NOT_CONNECTED
}
enum DocumentType {
  SOP
  BRAND_GUIDE
  FAQ
  PRODUCT_DOC
  REPORT
  PROPOSAL
  QUOTE
  MEETING_NOTE
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  imageUrl  String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships OrganizationMember[]
  runsStarted ExecutionRun[] @relation("RunStartedBy")
  approvalsRequested ApprovalItem[] @relation("ApprovalRequestedBy")
  accounts Account[]
  sessions Session[]
  automationProjectMembers AutomationProjectMember[]
  commandRuns CommandRun[] @relation("CommandRunRequestedBy")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  website     String?
  industry    String?
  defaultSignature String?
  mailStyleGuide String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members      OrganizationMember[]
  customers    Customer[]
  projects     Project[]
  agents       Agent[]
  workflows    Workflow[]
  runs         ExecutionRun[]
  approvals    ApprovalItem[]
  connections  ToolConnection[]
  documents    KnowledgeDocument[]
  financeItems FinanceItem[]
  ingestionSources IngestionSource[]
  ingestionItems IngestionItem[]
  ingestionJobs IngestionJob[]
  mailItems         MailItem[]
  proposals         Proposal[]
  presalesReviews   PresalesReview[]
  automationProjects AutomationProject[]
}

model OrganizationMember {
  id             String     @id @default(cuid())
  organizationId String
  userId String
  role           MemberRole @default(EDITOR)
  createdAt      DateTime   @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
}

model Customer {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  status         CustomerStatus @default(PROSPECT)
  industry       String?
  sizeLabel      String?
  website        String?
  notes          String?
  currentInfra   Json?
  productFit     ProductFamily[]
  opportunity    OpportunityLevel @default(MEDIUM)
  nextAction     String?
  nextActionDueAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  projects     Project[]
  mailItems    MailItem[]
  proposals    Proposal[]
  financeItems FinanceItem[]
  @@index([organizationId, name])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  email      String?
  phone      String?
  title      String?
  department String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String?
  name           String
  productFamily  ProductFamily[]
  status         ProjectStatus @default(NEW_LEAD)
  opportunity    OpportunityLevel @default(MEDIUM)
  expectedRevenue Decimal?
  dueAt          DateTime?
  summary        String?
  nextAction     String?
  riskLevel      RiskLevel @default(MEDIUM)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  requests     ProjectRequest[]
  mailItems    MailItem[]
  presalesReviews PresalesReview[]
  proposals    Proposal[]
  tasks        Task[]
  runs         ExecutionRun[]
  approvals    ApprovalItem[]
  financeItems FinanceItem[]
  @@index([organizationId, status])
}

model ProjectRequest {
  id        String   @id @default(cuid())
  projectId String
  source    String?
  rawText   String
  extracted Json?
  requiredAction String?
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model MailItem {
  id             String @id @default(cuid())
  organizationId String
  customerId     String?
  projectId      String?
  provider       ConnectionProvider
  externalMessageId String?
  threadKey      String?
  fromEmail      String?
  fromName       String?
  toEmails       String[]
  subject        String?
  snippet        String?
  bodyText       String?
  receivedAt     DateTime?
  type           MailItemType @default(UNKNOWN)
  actionStatus   MailActionStatus @default(UNCLASSIFIED)
  urgencyScore   Int?
  extracted      Json?
  replyDraft     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id])
  project      Project?  @relation(fields: [projectId], references: [id])
  runs         ExecutionRun[]
  ingestionItems IngestionItem[]
}

model IngestionSource {
  id             String   @id @default(cuid())
  organizationId String
  sourceType     IngestionSourceType
  provider       ConnectionProvider?
  label          String
  cursor         String?
  syncMode       String?
  lastSyncAt     DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items         IngestionItem[]
  jobs          IngestionJob[]
  @@unique([organizationId, sourceType])
}

model IngestionItem {
  id             String   @id @default(cuid())
  organizationId String
  sourceId       String
  sourceType     IngestionSourceType
  externalId     String
  sourceLabel    String
  sourceRef      String
  changeType     String
  title          String
  summary        String
  customerName   String
  projectName    String?
  status         IngestionStatus @default(RECEIVED)
  approvalStatus IngestionApprovalStatus @default(NOT_REQUIRED)
  approvalRequired Boolean @default(false)
  priority       RiskLevel @default(MEDIUM)
  occurredAt     DateTime
  receivedAt     DateTime @default(now())
  participants   Json?
  attachments    Json?
  rawContent     String
  normalizedContent String
  extractedRequest String
  suggestedReply String
  actionItems    Json?
  decisions      Json?
  transcriptText String?
  transcriptSegments Json?
  audioUrl       String?
  mailDirection   IngestionMailDirection?
  mailCategory   IngestionMailCategory?
  relatedMailItemId String?
  relatedRunId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source        IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  relatedMailItem MailItem? @relation(fields: [relatedMailItemId], references: [id])
  relatedRun     ExecutionRun? @relation(fields: [relatedRunId], references: [id])
  @@unique([organizationId, sourceType, externalId])
}

model IngestionJob {
  id             String @id @default(cuid())
  organizationId String
  sourceId       String
  sourceType     IngestionSourceType
  mode           String
  status         IngestionJobStatus @default(RUNNING)
  itemCount      Int @default(0)
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  message        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model PresalesReview {
  id             String @id @default(cuid())
  organizationId String
  projectId      String?
  title          String
  productFamily  ProductFamily[]
  status         ReviewStatus @default(DRAFT)
  feasibility    FeasibilityStatus @default(NEEDS_CONFIRMATION)
  requestSummary String?
  missingInfo    Json?
  checklist      Json?
  internalNotes  String?
  customerReplyDraft String?
  vendorQuestionDraft String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project? @relation(fields: [projectId], references: [id])
}

model Proposal {
  id             String @id @default(cuid())
  organizationId String
  customerId     String?
  projectId      String?
  title          String
  status         ProposalStatus @default(DRAFT)
  productFamily  ProductFamily[]
  bom            Json?
  amount         Decimal?
  currency       String @default("KRW")
  customerSummary String?
  partnerRequestDraft String?
  validUntil     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id])
  project      Project?  @relation(fields: [projectId], references: [id])
  approvals    ApprovalItem[]
}

model Task {
  id        String   @id @default(cuid())
  projectId String?
  title     String
  description String?
  status    String @default("todo")
  priority  String @default("medium")
  dueAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Agent {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  department     String?
  roleTitle      String?
  description    String?
  personaPrompt  String?
  status         AgentStatus @default(DRAFT)
  goals          Json?
  allowedTools   String[]
  blockedActions String[]
  outputFormats  String[]
  approvalPolicy Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflows    Workflow[]
  runs         ExecutionRun[]
}

model Workflow {
  id             String @id @default(cuid())
  organizationId String
  agentId        String?
  name           String
  description    String?
  status         WorkflowStatus @default(DRAFT)
  triggerType    TriggerType
  triggerConfig  Json?
  steps          Json?
  approvalRule   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent? @relation(fields: [agentId], references: [id])
  runs         ExecutionRun[]
}

model ExecutionRun {
  id             String @id @default(cuid())
  organizationId String
  workflowId     String?
  agentId        String?
  projectId      String?
  mailItemId     String?
  startedById    String?
  title          String
  input          Json?
  plan           Json?
  output         Json?
  status         RunStatus @default(QUEUED)
  riskLevel      RiskLevel @default(LOW)
  errorMessage   String?
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow? @relation(fields: [workflowId], references: [id])
  agent        Agent? @relation(fields: [agentId], references: [id])
  project      Project? @relation(fields: [projectId], references: [id])
  mailItem     MailItem? @relation(fields: [mailItemId], references: [id])
  startedBy    User? @relation("RunStartedBy", fields: [startedById], references: [id])
  steps        RunStep[]
  approvals    ApprovalItem[]
  ingestionItems IngestionItem[]
}

model RunStep {
  id        String @id @default(cuid())
  runId     String
  name      String
  status    RunStatus
  input     Json?
  output    Json?
  error     String?
  startedAt DateTime @default(now())
  endedAt   DateTime?
  run ExecutionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ApprovalItem {
  id             String @id @default(cuid())
  organizationId String
  runId          String?
  projectId      String?
  proposalId     String?
  requestedById  String?
  title          String
  summary        String?
  actionType     ApprovalActionType
  riskLevel      RiskLevel @default(MEDIUM)
  status         ApprovalStatus @default(PENDING)
  destination    String?
  preview        Json?
  warning        String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          ExecutionRun? @relation(fields: [runId], references: [id])
  project      Project? @relation(fields: [projectId], references: [id])
  proposal     Proposal? @relation(fields: [proposalId], references: [id])
  requestedBy  User? @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
}

model ToolConnection {
  id             String @id @default(cuid())
  organizationId String
  provider       ConnectionProvider
  status         ConnectionStatus @default(NOT_CONNECTED)
  accountLabel   String?
  scopes         String[]
  metadata       Json?
  connectedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, provider])
}

model KnowledgeDocument {
  id             String @id @default(cuid())
  organizationId String
  title          String
  type           DocumentType @default(OTHER)
  content        String?
  sourceUrl      String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model FinanceItem {
  id             String @id @default(cuid())
  organizationId String
  customerId     String?
  projectId      String?
  type           String
  title          String
  amount         Decimal
  currency       String @default("KRW")
  expectedAt     DateTime?
  confirmedAt    DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id])
  project      Project?  @relation(fields: [projectId], references: [id])
}


enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model IntegrationHealth {
  id            String    @id @default(cuid())
  serviceKey    String    @unique @map("service_key")
  status        String    @default("unknown")
  lastCheckedAt DateTime? @map("last_checked_at")
  details       Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("integration_health")
}

// --- M2: portal automation/kernel (additive, Automation* on BLRO conflicts) ---

model AutomationProject {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  slug           String   @unique
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization?            @relation(fields: [organizationId], references: [id])
  members            AutomationProjectMember[]
  commandRuns        CommandRun[]
  mailInsightThreads MailInsightThread[]
  policyMemories     PolicyMemory[]
  policyDecisionLogs PolicyDecisionLog[]
  workspaces         AutomationWorkspace[]
  automationPortalTasks AutomationPortalTask[]
  automationKnowledgeDocuments AutomationKnowledgeDocument[]
  automationMailAccounts AutomationMailAccount[]

  @@index([organizationId])
  @@map("automation_projects")
}

model AutomationProjectMember {
  id                  String   @id @default(cuid())
  automationProjectId String   @map("automation_project_id")
  userId              String   @map("user_id")
  role                String   @default("member")
  createdAt           DateTime @default(now()) @map("created_at")

  automationProject AutomationProject @relation(fields: [automationProjectId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([automationProjectId, userId])
  @@map("automation_project_members")
}

model AutomationWorkspace {
  id                  String   @id @default(cuid())
  automationProjectId String   @map("automation_project_id")
  name                String
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  automationProject AutomationProject @relation(fields: [automationProjectId], references: [id], onDelete: Cascade)

  @@index([automationProjectId])
  @@map("automation_workspaces")
}

model ConfigProfile {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  values ConfigValue[]

  @@map("config_profiles")
}

model ConfigValue {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  key       String
  valueJson Json     @map("value_json")
  createdAt DateTime @default(now()) @map("created_at")

  profile ConfigProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, key])
  @@map("config_values")
}

model Command {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  runs CommandRun[]

  @@map("commands")
}

model CommandRun {
  id                   String   @id @default(cuid())
  commandId            String   @map("command_id")
  automationProjectId  String   @map("automation_project_id")
  requestedById        String?  @map("requested_by_id")
  status               String   @default("pending")
  inputSummary         String?  @map("input_summary")
  sourceEntityType     String?  @map("source_entity_type")
  sourceEntityId       String?  @map("source_entity_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  command              Command              @relation(fields: [commandId], references: [id])
  automationProject    AutomationProject    @relation(fields: [automationProjectId], references: [id])
  requestedBy          User?                @relation("CommandRunRequestedBy", fields: [requestedById], references: [id])
  automationWorkflows  AutomationWorkflow[]
  intent               IntentAnalysis?
  risk                 RiskAnalysis?
  codeChanges          CodeChange[]         @relation("CommandRunCodeChanges")
  skillRuns            SkillRun[]
  workBreakdownItems   WorkBreakdownItem[]
  improvementCandidates ImprovementCandidate[]

  @@index([automationProjectId, status])
  @@index([commandId])
  @@index([sourceEntityType, sourceEntityId])
  @@map("command_runs")
}

model ImprovementCandidate {
  id              String   @id @default(cuid())
  sourceType      String   @map("source_type")
  sourceId        String?  @map("source_id")
  title           String
  summary         String
  severity        String   @default("medium")
  suggestedModule String?  @map("suggested_module")
  suggestedAction String?  @map("suggested_action")
  status          String   @default("proposed")
  commandRunId    String?  @map("command_run_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  commandRun CommandRun? @relation(fields: [commandRunId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("improvement_candidates")
}

model AutomationWorkflow {
  id           String   @id @default(cuid())
  commandRunId String   @map("command_run_id")
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  commandRun CommandRun               @relation(fields: [commandRunId], references: [id], onDelete: Cascade)
  steps      AutomationWorkflowStep[]

  @@index([commandRunId])
  @@map("automation_workflows")
}

model AutomationWorkflowStep {
  id                   String   @id @default(cuid())
  automationWorkflowId String   @map("automation_workflow_id")
  stepKey              String   @map("step_key")
  status               String   @default("pending")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  automationWorkflow AutomationWorkflow @relation(fields: [automationWorkflowId], references: [id], onDelete: Cascade)
  agentAssignments   AgentAssignment[]
  validationResults  ValidationResult[]

  @@index([automationWorkflowId, sortOrder])
  @@map("automation_workflow_steps")
}

model AgentAssignment {
  id                       String   @id @default(cuid())
  automationWorkflowStepId String   @map("automation_workflow_step_id")
  agentKey                 String   @map("agent_key")
  status                   String   @default("assigned")
  createdAt                DateTime @default(now()) @map("created_at")

