// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts           Account[]
  sessions           Session[]
  projects           Project[]
  customers          Customer[]
  partners           Partner[]
  workflows          Workflow[]
  knowledgeDocuments KnowledgeDocument[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Project model
model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(INTAKE)
  priority    Priority      @default(MEDIUM)
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id])
  tasks   Task[]
  results Result[]

  @@map("projects")
}

// Task model
model Task {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(BACKLOG)
  priority    Priority   @default(MEDIUM)
  assignee    AgentType  @default(HERMES)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  // Relations
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results    Result[]
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  @@map("tasks")
}

// Result model
model Result {
  id        String       @id @default(cuid())
  taskId    String
  projectId String
  phase     String
  type      ResultType
  status    ResultStatus @default(DRAFT)
  content   Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("results")
}

// Agent Job model
model AgentJob {
  id          String    @id @default(cuid())
  taskId      String
  agentType   AgentType
  status      JobStatus @default(PENDING)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  input       Json
  output      Json?
  error       String?
  metadata    Json?

  @@map("agent_jobs")
}

// Customer model (AIOS v1 통합)
model Customer {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  industry  String?
  status    String   @default("active")
  notes     String?
  metadata  Json?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id])
  contacts Contact[]
  tasks    Task[]

  @@map("customers")
}

// Partner model (AIOS v1 통합)
model Partner {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  type      String?
  status    String   @default("active")
  notes     String?
  metadata  Json?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("partners")
}

// Contact model
model Contact {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String?
  position   String?
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

// Mail Message model (Mail Intelligence 통합)
model MailMessage {
  id          String   @id @default(cuid())
  subject     String
  fromEmail   String
  fromName    String?
  bodyPreview String?
  body        String?
  receivedAt  DateTime
  isRead      Boolean  @default(false)
  importance  String?
  webLink     String?
  groupKey    String?
  status      String?
  aiAnalysis  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("mail_messages")
}

// Workflow model (F-aios-v3 통합)
model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String
  status      String   @default("active")
  config      Json?
  startStep   String?
  variables   Json?
  version     Int      @default(1)
  source      String   @default("aios-v2")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user       User                @relation(fields: [userId], references: [id])
  steps      WorkflowStep[]
  executions WorkflowExecution[]

  @@map("workflows")
}

// Workflow Step model (F-aios-v3 통합)
model WorkflowStep {
  id          String   @id @default(cuid())
  workflowId  String
  name        String
  type        String   @default("action")
  stepOrder   Int      @default(0)
  config      Json?
  nextSteps   String[]
  timeout     Int?
  retryPolicy Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_steps")
}

// Workflow Execution model
model WorkflowExecution {
  id             String    @id @default(cuid())
  workflowId     String
  status         String    @default("pending")
  input          Json?
  output         Json?
  error          String?
  stepResults    Json?
  mode           String    @default("real")
  engine         String?
  approvalId     String?
  requestedBy    String?
  idempotencyKey String?   @unique
  traceId        String?   @unique
  heartbeatAt    DateTime?
  attempt        Int       @default(0)
  metadata       Json?
  createdAt      DateTime  @default(now())
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  // Relations
  workflow Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  events   WorkflowExecutionEvent[]

  @@index([status, createdAt])
  @@index([workflowId, startedAt])
  @@map("workflow_executions")
}

model WorkflowExecutionEvent {
  id          String   @id @default(cuid())
  executionId String
  sequence    Int
  type        String
  payload     Json
  createdAt   DateTime @default(now())

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, sequence])
  @@index([executionId, createdAt])
  @@map("workflow_execution_events")
}

model ApprovalRequestRecord {
  id           String    @id
  type         String
  sessionId    String
  assignmentId String
  requester    String
  requestedBy  String
  actionType   String
  target       String
  context      Json
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?
  resolution   String?

  @@index([status, createdAt])
  @@index([sessionId])
  @@map("approval_requests")
}

model EvidenceArtifact {
  id          String   @id @default(cuid())
  sessionId   String?
  executionId String?
  type        String
  path        String?
  description String
  checksum    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([executionId, createdAt])
  @@map("evidence_artifacts")
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String
  action       String
  resourceType String
  resourceId   String?
  approvalId   String?
  traceId      String?
  payload      Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id          String    @id @default(cuid())
  topic       String
  aggregateId String
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([status, availableAt])
  @@map("outbox_events")
}

// Knowledge Document model (지식베이스 통합)
model KnowledgeDocument {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String?
  tags        String[]
  source      String?
  checksum    String?
  indexStatus String   @default("pending")
  provider    String?
  externalRef String?
  metadata    Json?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("knowledge_documents")
}

// Learning Data model (학습 데이터 통합)
model LearningData {
  id        String   @id @default(cuid())
  type      String
  input     Json
  output    Json
  feedback  String?
  score     Float?
  userId    String
  createdAt DateTime @default(now())

  @@map("learning_data")
}

// Kanban Board model
model KanbanBoard {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  columns KanbanColumn[]

  @@map("kanban_boards")
}

model KanbanColumn {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  position  Int
  createdAt DateTime @default(now())

  // Relations
  board KanbanBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards KanbanCard[]

  @@map("kanban_columns")
}

model KanbanCard {
  id          String     @id @default(cuid())
  columnId    String
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(BACKLOG)
  assignee    String?
  position    Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  column KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@map("kanban_cards")
}

// Lifecycle workflow persistence (Mail → CRM → Opportunity → Project → Maintenance)
model LifecycleRecord {
  id              String   @id @default(cuid())
  entityType      String
  status          String
  payload         Json
  domain          String?
  sourceThreadKey String?
  projectId       String?
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([entityType])
  @@index([domain])
  @@index([sourceThreadKey])
  @@index([projectId])
  @@map("lifecycle_records")
}

// Enums
enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  INTAKE
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  DONE
  BLOCKED
  DEFERRED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AgentType {
  HERMES
  OPENCODE
  MANUAL
}

enum ResultType {
  SUCCESS
  FAILURE
  PARTIAL
  DEFERRED
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
