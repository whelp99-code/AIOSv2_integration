// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts  Account[]
  sessions  Session[]
  projects  Project[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Project model
model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(INTAKE)
  priority    Priority      @default(MEDIUM)
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  tasks  Task[]
  results Result[]

  @@map("projects")
}

// Task model
model Task {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(BACKLOG)
  priority    Priority   @default(MEDIUM)
  assignee    AgentType  @default(HERMES)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results Result[]

  @@map("tasks")
}

// Result model
model Result {
  id        String       @id @default(cuid())
  taskId    String
  projectId String
  phase     String
  type      ResultType
  status    ResultStatus @default(DRAFT)
  content   Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("results")
}

// Agent Job model
model AgentJob {
  id          String    @id @default(cuid())
  taskId      String
  agentType   AgentType
  status      JobStatus @default(PENDING)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  input       Json
  output      Json?
  error       String?
  metadata    Json?

  @@map("agent_jobs")
}

// Kanban Board model
model KanbanBoard {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  columns KanbanColumn[]

  @@map("kanban_boards")
}

model KanbanColumn {
  id        String       @id @default(cuid())
  boardId   String
  name      String
  position  Int
  createdAt DateTime     @default(now())

  // Relations
  board KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards KanbanCard[]

  @@map("kanban_columns")
}

model KanbanCard {
  id          String     @id @default(cuid())
  columnId    String
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(BACKLOG)
  assignee    String?
  position    Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  column KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@map("kanban_cards")
}

// Enums
enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  INTAKE
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  DONE
  BLOCKED
  DEFERRED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AgentType {
  HERMES
  OPENCODE
  MANUAL
}

enum ResultType {
  SUCCESS
  FAILURE
  PARTIAL
  DEFERRED
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
